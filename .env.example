# Your store domain. Either form is accepted:
# corvital-plus.myshopify.com
# corvital-plus
SHOPIFY_SHOP=corvital-plus.myshopify.com

# From Shopify Dev Dashboard -> App settings -> Credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

SHOPIFY_API_VERSION=2026-07

# Public HTTPS URL of this running service, with NO trailing slash.
# Example: https://corvital-metafields.example.com
PUBLIC_BASE_URL=

PORT=3000
